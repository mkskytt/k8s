{
  "uid": "motorinfo-frontend",
  "title": "Motorinfo — Frontend (Faro RUM)",
  "tags": ["motorinfo", "faro", "frontend", "managed-by-claude"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Active sessions (24h)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "count(sum by (session_id) (count_over_time({service_name=\"Motorinfo\", kind=\"event\"} | logfmt | event_name=\"session_start\" [24h])))", "refId": "A", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}},
    {"id": 2, "type": "stat", "title": "Page views (1h)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "sum(count_over_time({service_name=\"Motorinfo\", kind=\"event\"} | logfmt | event_name=\"view_changed\" [1h]))", "refId": "A", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}},
    {"id": 3, "type": "stat", "title": "JS errors (1h)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "sum(count_over_time({service_name=\"Motorinfo\", kind=\"exception\"} [1h]))", "refId": "A", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}},
    {"id": 4, "type": "stat", "title": "Slow LCPs (p95 > 2.5s, 1h)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "quantile_over_time(0.95, {service_name=\"Motorinfo\", kind=\"measurement\"} | logfmt | measurement_name=\"largest_contentful_paint\" | unwrap measurement_value [1h])", "refId": "A", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2500}, {"color": "red", "value": 4000}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}},
    {"id": 5, "type": "timeseries", "title": "Page-load events / 5m", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "sum by (event_name) (rate({service_name=\"Motorinfo\", kind=\"event\"} | logfmt | event_name=~\"session_start|view_changed|session_extend\" [5m]))", "refId": "A", "legendFormat": "{{event_name}}"}],
     "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 6, "type": "timeseries", "title": "Core Web Vitals (p75)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [
       {"expr": "quantile_over_time(0.75, {service_name=\"Motorinfo\", kind=\"measurement\"} | logfmt | measurement_name=\"largest_contentful_paint\" | unwrap measurement_value [5m])", "refId": "LCP", "legendFormat": "LCP p75"},
       {"expr": "quantile_over_time(0.75, {service_name=\"Motorinfo\", kind=\"measurement\"} | logfmt | measurement_name=\"first_contentful_paint\" | unwrap measurement_value [5m])", "refId": "FCP", "legendFormat": "FCP p75"},
       {"expr": "quantile_over_time(0.75, {service_name=\"Motorinfo\", kind=\"measurement\"} | logfmt | measurement_name=\"cumulative_layout_shift\" | unwrap measurement_value [5m]) * 1000", "refId": "CLS", "legendFormat": "CLS p75 (×1000)"},
       {"expr": "quantile_over_time(0.75, {service_name=\"Motorinfo\", kind=\"measurement\"} | logfmt | measurement_name=\"interaction_to_next_paint\" | unwrap measurement_value [5m])", "refId": "INP", "legendFormat": "INP p75"}
     ],
     "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0}}}},
    {"id": 7, "type": "table", "title": "Top pages (1h)", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "topk(10, sum by (page_url) (count_over_time({service_name=\"Motorinfo\", kind=\"event\"} | logfmt | event_name=\"view_changed\" [1h])))", "refId": "A", "instant": true}],
     "transformations": [{"id": "organize", "options": {"renameByName": {"page_url": "Page URL", "Value": "Views"}}}]},
    {"id": 8, "type": "table", "title": "Top browsers (1h)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "topk(10, sum by (browser_name) (count_over_time({service_name=\"Motorinfo\", kind=\"event\"} | logfmt | event_name=\"session_start\" [1h])))", "refId": "A", "instant": true}],
     "transformations": [{"id": "organize", "options": {"renameByName": {"browser_name": "Browser", "Value": "Sessions"}}}]},
    {"id": 9, "type": "logs", "title": "JS errors (last 1h)", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "{service_name=\"Motorinfo\", kind=\"exception\"}", "refId": "A"}],
     "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
