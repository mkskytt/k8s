{
  "uid": "ytt-cluster",
  "title": "ytt Cluster — Overview",
  "tags": ["cluster", "k8s", "managed-by-claude"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "node", "type": "query", "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "query": {"query": "label_values(kube_node_info, node)", "refId": "node"},
     "refresh": 2, "multi": true, "includeAll": true, "current": {"selected": true, "text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Nodes Ready", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 2, "type": "stat", "title": "Pods Running", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 3, "type": "stat", "title": "Pods not ready", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(kube_pod_status_phase{phase=~\"Failed|Pending|Unknown\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 4, "type": "stat", "title": "Restarts (1h)", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total[1h]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 5, "type": "stat", "title": "CPU usage cluster", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / sum(machine_cpu_cores or kube_node_status_capacity{resource=\"cpu\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 6, "type": "stat", "title": "Memory used", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * (sum(node_memory_MemTotal_bytes) - sum(node_memory_MemAvailable_bytes)) / sum(node_memory_MemTotal_bytes)", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 7, "type": "timeseries", "title": "CPU per node", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$node.*\"}[5m])))", "refId": "A", "legendFormat": "{{instance}}"}],
     "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 8, "type": "timeseries", "title": "Memory per node", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$node.*\"} / node_memory_MemTotal_bytes{instance=~\"$node.*\"})", "refId": "A", "legendFormat": "{{instance}}"}],
     "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 9, "type": "timeseries", "title": "Pod count by namespace", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})", "refId": "A", "legendFormat": "{{namespace}}"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 0, "fillOpacity": 80, "stacking": {"mode": "normal"}}}}},
    {"id": 10, "type": "table", "title": "Top restart counts (1h)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "topk(15, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])))", "refId": "A", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"namespace": "Namespace", "pod": "Pod", "Value": "Restarts"}}}]},
    {"id": 11, "type": "logs", "title": "Recent k8s events (warnings + errors)", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "{job=\"integrations/kubernetes/eventhandler\"} | json | type=~\"Warning|Error\"", "refId": "A"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
