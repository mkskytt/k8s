{
  "uid": "motorinfo-db",
  "title": "Motorinfo — PostgreSQL (CNPG)",
  "tags": ["motorinfo", "postgres", "cnpg", "managed-by-claude"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "Instances ready", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(kube_pod_status_ready{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\", condition=\"true\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 2, "type": "stat", "title": "Restarts (24h)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\"}[24h]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 3, "type": "stat", "title": "CPU usage (cluster)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\", container=\"postgres\"}[5m]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 0.9}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}},
    {"id": 4, "type": "stat", "title": "Memory (cluster)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\", container=\"postgres\"})", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 5, "type": "timeseries", "title": "Per-instance CPU", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\", container=\"postgres\"}[5m]))", "refId": "A", "legendFormat": "{{pod}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 6, "type": "timeseries", "title": "Per-instance memory", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\", container=\"postgres\"})", "refId": "A", "legendFormat": "{{pod}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 7, "type": "timeseries", "title": "PVC bytes used", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "kubelet_volume_stats_used_bytes{namespace=\"motorinfo\", persistentvolumeclaim=~\"motorinfo-db-.*\"}", "refId": "A", "legendFormat": "{{persistentvolumeclaim}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 8, "type": "timeseries", "title": "PVC free space", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * (kubelet_volume_stats_available_bytes{namespace=\"motorinfo\", persistentvolumeclaim=~\"motorinfo-db-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"motorinfo\", persistentvolumeclaim=~\"motorinfo-db-.*\"})", "refId": "A", "legendFormat": "{{persistentvolumeclaim}}"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 15}, {"color": "green", "value": 30}]}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 9, "type": "logs", "title": "Postgres logs (motorinfo-db)", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 10},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "{namespace=\"motorinfo\", pod=~\"motorinfo-db-.*\"} | logfmt | level=~\"(?i)error|warning|fatal\"", "refId": "A"}],
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
