{
  "uid": "motorinfo-apm",
  "title": "Motorinfo — Application APM",
  "tags": ["motorinfo", "apm", "managed-by-claude"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "service", "type": "query", "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "query": {"query": "label_values(target_info{service_namespace=\"motorinfo\"}, service_name)", "refId": "StandardVariableQuery"},
     "refresh": 2, "multi": true, "includeAll": true, "current": {"selected": true, "text": "All", "value": "$__all"}},
    {"name": "instance", "type": "query", "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "query": {"query": "label_values(target_info{service_namespace=\"motorinfo\", service_name=~\"$service\"}, service_instance_id)", "refId": "StandardVariableQuery"},
     "refresh": 2, "multi": true, "includeAll": true, "current": {"selected": true, "text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Request rate", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 2, "type": "stat", "title": "Error rate", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\", http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])), 1)", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 3, "type": "stat", "title": "p95 latency", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.2}, {"color": "red", "value": 1}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 4, "type": "stat", "title": "p99 latency", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 2}]}}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}},
    {"id": 5, "type": "timeseries", "title": "Request rate by service", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m]))", "refId": "A", "legendFormat": "{{service_name}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 6, "type": "timeseries", "title": "Status codes", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m]))", "refId": "A", "legendFormat": "{{http_response_status_code}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 0, "fillOpacity": 80, "stacking": {"mode": "normal"}, "lineInterpolation": "stepBefore"}}}},
    {"id": 7, "type": "timeseries", "title": "Latency percentiles (p50 / p95 / p99)", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])))", "refId": "p50", "legendFormat": "p50 {{service_name}}"},
       {"expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])))", "refId": "p95", "legendFormat": "p95 {{service_name}}"},
       {"expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m])))", "refId": "p99", "legendFormat": "p99 {{service_name}}"}
     ],
     "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 0}}}},
    {"id": 8, "type": "table", "title": "Top routes (requests / 5m)", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "topk(10, sum by (service_name, http_route, http_request_method) (rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m]) * 300))", "refId": "A", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"service_name": "Service", "http_route": "Route", "http_request_method": "Method", "Value": "req/5m"}}}]},
    {"id": 9, "type": "table", "title": "Top error routes (5xx / 5m)", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "topk(10, sum by (service_name, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\", http_response_status_code=~\"5..\"}[5m]) * 300))", "refId": "A", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"service_name": "Service", "http_route": "Route", "http_response_status_code": "Status", "Value": "errors/5m"}}}]},
    {"id": 10, "type": "timeseries", "title": ".NET GC collections", "gridPos": {"x": 0, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (dotnet_gc_heap_generation) (rate(dotnet_gc_collections_total{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"}[5m]))", "refId": "A", "legendFormat": "{{dotnet_gc_heap_generation}}"}],
     "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 11, "type": "timeseries", "title": "Process memory", "gridPos": {"x": 8, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
     "targets": [{"expr": "sum by (service_instance_id) (process_memory_usage_bytes{service_namespace=\"motorinfo\", service_name=~\"$service\", service_instance_id=~\"$instance\"})", "refId": "A", "legendFormat": "{{service_instance_id}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}}},
    {"id": 12, "type": "logs", "title": "Recent errors", "gridPos": {"x": 16, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "loki", "uid": "grafanacloud-logs"},
     "targets": [{"expr": "{service_namespace=\"motorinfo\", service_name=~\"$service\"} | severity_text =~ \"(?i)error|warn|critical\"", "refId": "A"}],
     "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
